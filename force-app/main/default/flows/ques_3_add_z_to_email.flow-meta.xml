<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>add_z_to_email</name>
        <label>add z to  email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Email</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>z</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>check_for_20_character</name>
        <label>check for 20 character</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>no</defaultConnectorLabel>
        <rules>
            <name>yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>email20character</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>add_z_to_email</targetReference>
            </connector>
            <label>yes</label>
        </rules>
    </decisions>
    <description>Write automation to copy a lead’s email.
Then, once the email is copied, Donna wants to check the length of the email. If the length of the email is less than 20 then, she wants to append the character ‘z’ to the email.</description>
    <environments>Default</environments>
    <formulas>
        <name>email20character</name>
        <dataType>Boolean</dataType>
        <expression>LEN({!$Record.Email})&lt;20</expression>
    </formulas>
    <interviewLabel>ques 3 add z to email {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Add z to email-ques3</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>check_for_20_character</targetReference>
        </connector>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
