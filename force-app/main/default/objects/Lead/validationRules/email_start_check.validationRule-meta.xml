<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>email_start_check</fullName>
    <active>true</active>
    <errorConditionFormula>REGEX(Email, &quot;^(info|contact|career)@.*&quot;)</errorConditionFormula>
    <errorMessage>Lead email cannot start with info@, contact@, or career@.</errorMessage>
</ValidationRule>
