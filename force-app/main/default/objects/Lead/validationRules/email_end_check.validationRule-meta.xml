<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>email_end_check</fullName>
    <active>true</active>
    <errorConditionFormula>REGEX(Email, &quot;.*\\.(games|garden|glass|free|talk)$&quot;)</errorConditionFormula>
    <errorMessage>Lead email cannot use this domain.</errorMessage>
</ValidationRule>
